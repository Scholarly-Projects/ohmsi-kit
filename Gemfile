# frozen_string_literal: true

# Gems for the local transcript editing workspace.
# Run `bundle install` once, then `bundle exec jekyll s` from the toolkit root.
# (The OHD template's Rake/image gems are not needed here.)

source 'https://rubygems.org'

gem 'jekyll', '~> 4.4'
gem 'webrick'   # local server, no longer bundled with Ruby 3+
gem 'logger'
gem 'base64'
gem 'csv'       # not bundled with Ruby 3.4+; used by Jekyll and the editor plugin
